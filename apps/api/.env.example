# Server configuration
PORT=4001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Local PostgreSQL 16 connection URL
# Replace [YOUR_PASSWORD] with your local PostgreSQL user password
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@localhost:5432/tripnest?schema=public"

# Authentication Security
JWT_SECRET=your_jwt_secret_min_32_chars_for_production
JWT_EXPIRES_IN=7d

# Google Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_REQUEST_TIMEOUT_MS=20000
AI_RATE_LIMIT_MAX_PER_MINUTE=5
