# ========================================================
# TripNest — Root Environment Configuration
# ========================================================

# API Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Local PostgreSQL 16 Database Configuration
# Replace [YOUR_PASSWORD] with your local PostgreSQL user password
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@localhost:5432/tripnest?schema=public"

# Authentication Security
JWT_SECRET=your_jwt_secret_min_32_chars_for_production
JWT_EXPIRES_IN=7d

# Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=TripNest
